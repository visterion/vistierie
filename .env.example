# Copy to .env and fill in. `docker compose` reads .env automatically.
#   cp .env.example .env

# ---- Required ------------------------------------------------------------

# Postgres password. Any value; the database is created with it on first start.
VISTIERIE_DB_PASSWORD=change-me

# bcrypt hash of your admin token — NOT the token itself. Must be non-empty;
# compose refuses to start otherwise. Until it is a real hash, every /admin/
# request is rejected with 401.
# See documentation/operations.md#generating-the-admin-token-hash
VISTIERIE_ADMIN_TOKEN_HASH=replace-with-bcrypt-hash

# ---- Providers (all optional) --------------------------------------------
# With none set, run with VISTIERIE_MOCK_LLM=true to serve canned responses.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# AWS Bedrock
BEDROCK_ENABLED=false
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=

# Claude Max subscription via the claude-bridge sidecar.
# Start it with: docker compose --profile subscription up -d
CLAUDE_SUBSCRIPTION_ENABLED=false
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_BRIDGE_URL=http://claude-bridge:8091
CLAUDE_SUBSCRIPTION_COOLDOWN_SECONDS=3600

# ---- Runtime -------------------------------------------------------------

# Serve deterministic canned responses; no provider calls, no cost.
VISTIERIE_MOCK_LLM=false

# Host port for the API.
VISTIERIE_PORT=8090

# Log levels: ERROR | WARN | INFO | DEBUG | TRACE
VISTIERIE_LOG_AGENT=INFO
VISTIERIE_LOG_LLM=INFO

# Pin an image instead of tracking :main
# VISTIERIE_IMAGE=ghcr.io/visterion/vistierie:main
# CLAUDE_BRIDGE_IMAGE=ghcr.io/visterion/vistierie-claude-bridge:main

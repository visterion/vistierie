# Copy to .env and fill in. `docker compose` reads .env automatically.
#   cp .env.example .env
#
# !!! ANY value containing a `$` MUST be wrapped in single quotes !!!
# Docker Compose interpolates `$name` sequences in .env values. An unquoted
# bcrypt hash such as $2y$12$sEMQ... loses `$sEMQ...` — compose only warns
# ("The \"sEMQ...\" variable is not set. Defaulting to a blank string.") and the
# container silently receives a corrupted value. Single quotes disable that:
#   VISTIERIE_ADMIN_TOKEN_HASH='$2y$12$sEMQ...'
# This affects VISTIERIE_ADMIN_TOKEN_HASH (a bcrypt hash always contains `$`)
# and any generated password, e.g. VISTIERIE_DB_PASSWORD.

# ---- Required ------------------------------------------------------------

# Postgres password. Generate one — do NOT ship this file's value:
#   openssl rand -base64 24
# Keep the single quotes: a generated password may contain `$` (see the warning
# at the top of this file).
# The database is created with this password on first start; changing it later
# requires recreating the volume (docker compose down -v).
VISTIERIE_DB_PASSWORD='replace-with-generated-password'

# bcrypt hash of your admin token — NOT the token itself. Must be non-empty;
# compose refuses to start otherwise. Until it is a real hash, every /admin/
# request is rejected with 401.
# Keep the single quotes — a bcrypt hash always contains `$` and is corrupted
# without them (see the warning at the top of this file).
# See documentation/operations.md#generating-the-admin-token-hash
VISTIERIE_ADMIN_TOKEN_HASH='replace-with-bcrypt-hash'

# ---- Providers (all optional) --------------------------------------------
# With none set, run with VISTIERIE_MOCK_LLM=true to serve canned responses.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# AWS Bedrock
BEDROCK_ENABLED=false
# Empty is not "off" here: the AWS SDK then resolves the region from its own
# default chain (AWS_DEFAULT_REGION, shared config profile, instance metadata).
AWS_REGION=
# Standard AWS credential chain. Leave all three blank to use a shared
# credentials file, an EC2 instance profile or an ECS task role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Alternative to the three above: Bedrock API-key (ABSK) auth.
AWS_BEARER_TOKEN_BEDROCK=

# Claude Max subscription via the claude-bridge sidecar.
# Start it with: docker compose --profile subscription up -d
CLAUDE_SUBSCRIPTION_ENABLED=false
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_BRIDGE_URL=http://claude-bridge:8091
CLAUDE_SUBSCRIPTION_COOLDOWN_SECONDS=3600
# Sidecar-side limits (defaults shown).
BRIDGE_QUERY_TIMEOUT_MS=290000
BRIDGE_SESSION_TTL_MS=300000

# ---- Runtime -------------------------------------------------------------

# Serve deterministic canned responses; no provider calls, no cost.
VISTIERIE_MOCK_LLM=false

# Host port for the API. Published on all interfaces — bind to 127.0.0.1 in
# compose if the host is reachable from an untrusted network.
VISTIERIE_PORT=8090

# Log levels: ERROR | WARN | INFO | DEBUG | TRACE
VISTIERIE_LOG_AGENT=INFO
VISTIERIE_LOG_LLM=INFO

# Directory for the rotating log file (14-day retention, 2GB cap). Point this
# at a bind-mounted host directory in production so logs survive the
# container being recreated; see documentation/operations.md.
# VISTIERIE_LOG_DIR=logs

# Pin an image instead of tracking :main
# VISTIERIE_IMAGE=ghcr.io/visterion/vistierie:main
# CLAUDE_BRIDGE_IMAGE=ghcr.io/visterion/vistierie-claude-bridge:main

# ---- Tuning (rarely needed) ----------------------------------------------
# Defaults shown; uncomment only to override.

# VISTIERIE_AUTH_CACHE_POSITIVE_TTL_SECONDS=60
# VISTIERIE_AUTH_CACHE_NEGATIVE_TTL_SECONDS=10
# VISTIERIE_AGENTS_SCHEDULER_TICK_MILLIS=30000
